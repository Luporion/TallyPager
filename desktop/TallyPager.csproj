<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.6.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.IO.Ports" Version="10.0.9" />
    <PackageReference Include="LibAtem" Version="1.0.0" />
    <PackageReference Include="log4net" Version="3.6.0" />
    <EmbeddedResource Include="obj/bundle/esptool.exe" LogicalName="Bundle.esptool.exe" />
  </ItemGroup>
</Project>
