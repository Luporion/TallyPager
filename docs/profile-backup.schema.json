{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TallyPager profile backup",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "active", "profiles"],
  "properties": {
    "version": { "const": 1 },
    "active": { "$ref": "#/$defs/id" },
    "profiles": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/profile" } }
  },
  "$defs": {
    "id": { "type": "string", "format": "uuid", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
    "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
    "roles": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/id" } },
    "sourceAddress": { "type": "string", "maxLength": 256 },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "atem": { "$ref": "#/$defs/sourceAddress" },
        "vmix": { "$ref": "#/$defs/sourceAddress" },
        "arbiter": { "$ref": "#/$defs/sourceAddress" },
        "atemEnabled": { "type": "boolean", "default": true },
        "vmixEnabled": { "type": "boolean", "default": true },
        "arbiterEnabled": { "type": "boolean", "default": true }
      }
    },
    "assignment": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["mixer", "input"],
      "properties": {
        "mixer": {
          "enum": [0, 1, 2, 3, 4, 5],
          "description": "Off, ATEM, vMix, Arbiter (device), Arbiter (ATEM), Arbiter (vMix)"
        },
        "input": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "key": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "inside": { "$ref": "#/$defs/assignment" },
        "outside": { "$ref": "#/$defs/assignment" },
        "middleCamera": { "type": ["integer", "null"], "minimum": 1, "maximum": 99 }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "roles"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "roles": { "$ref": "#/$defs/roles", "minItems": 1 }
      }
    },
    "quickText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "roles"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "chat": { "type": ["string", "null"], "maxLength": 160, "description": "The app also enforces a 160-byte UTF-8 limit." },
        "next": { "type": ["string", "null"], "maxLength": 80, "description": "The app also enforces an 80-byte UTF-8 limit." },
        "roles": { "$ref": "#/$defs/roles" },
        "group": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "requireAck": { "type": "boolean" },
        "ttlSeconds": { "type": ["integer", "null"], "minimum": 5, "maximum": 3600 }
      },
      "allOf": [
        {
          "if": { "required": ["group"], "properties": { "group": { "type": "string" } } },
          "then": { "properties": { "roles": { "maxItems": 0 } } },
          "else": { "properties": { "roles": { "minItems": 1 } } }
        },
        {
          "anyOf": [
            { "required": ["chat"], "properties": { "chat": { "type": "string" } } },
            { "required": ["next"], "properties": { "next": { "type": "string" } } }
          ]
        },
        {
          "if": { "required": ["requireAck"], "properties": { "requireAck": { "const": true } } },
          "then": { "required": ["chat"], "properties": { "chat": { "type": "string", "pattern": "\\S" } } }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sources", "roles", "groups", "texts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "sources": { "$ref": "#/$defs/sources" },
        "roles": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/role" } },
        "groups": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/group" } },
        "texts": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/quickText" } }
      }
    }
  }
}
